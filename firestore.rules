rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Check if user is admin (email-based for bootstrap or custom claims)
    function isAdmin() { 
      return isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'ynn.delro7@gmail.com'.lower() ||
          request.auth.token.email.lower() == 'orensechristianjohn@gmail.com'.lower() ||
          request.auth.token.email.lower() == 'raphsantos04@gmail.com'.lower() ||
          request.auth.token.email.lower() == 'thenamystic@gmail.com'.lower() ||
          request.auth.token.email.lower().matches('.*thenamystic.*') ||
          request.auth.token.email.lower().matches('.*raphsantos.*') ||
          request.auth.token.email.lower().matches('.*raphaelsantos.*') ||
          request.auth.token.email.lower().matches('.*raphael.*santos.*') ||
          request.auth.token.email.lower().matches('.*santos.*raphael.*')
        )) ||
        (request.auth.token.get('name', '') != null && (
          request.auth.token.get('name', '').lower().matches('.*raphsantos.*') ||
          request.auth.token.get('name', '').lower().matches('.*raphaelsantos.*') ||
          request.auth.token.get('name', '').lower().matches('.*raphael.*santos.*') ||
          request.auth.token.get('name', '').lower().matches('.*santos.*raphael.*')
        )) ||
        (request.auth.token.get('email', '') != null && (
          request.auth.token.get('email', '').lower().matches('.*thenamystic.*') ||
          request.auth.token.get('email', '').lower().matches('.*raphsantos04.*') ||
          request.auth.token.get('email', '').lower().matches('.*raphsantos.*') ||
          request.auth.token.get('email', '').lower().matches('.*raphaelsantos.*') ||
          request.auth.token.get('email', '').lower().matches('.*raphael.*santos.*') ||
          request.auth.token.get('email', '').lower().matches('.*santos.*raphael.*')
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      ); 
    }

    // --- Collections ---

    // 1. Users
    function isValidUser(data) {
      return (isAdmin() || data.get('userId', null) == request.auth.uid)
        && (data.get('email', null) == null || (data.email is string && data.email.size() < 256))
        && (data.get('displayName', null) == null || (data.displayName is string && data.displayName.size() < 200))
        && (data.get('role', null) == null || data.role in ['admin', 'donor'])
        && (data.get('loyaltyTier', null) == null || data.loyaltyTier in ['Bronze Champion', 'Silver Champion', 'Gold Champion', 'Platinum Champion'])
        && (data.get('totalContribution', null) == null || data.totalContribution is int || data.totalContribution is float)
        && (data.get('badges', null) == null || data.badges is list)
        && (data.get('emailVerified', null) == null || data.emailVerified is bool);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() && userId == request.auth.uid && isValidUser(incoming());
      allow update: if isSignedIn() && userId == request.auth.uid && (
        isValidUser(incoming()) || isAdmin()
      );
    }

    // 2. Patients
    function isValidPatient(data) {
      return (data.get('publicIdentifier', null) == null || (data.publicIdentifier is string && data.publicIdentifier.size() < 128))
        && (data.get('fullName', null) == null || (data.fullName is string && data.fullName.size() < 256))
        && (data.get('fundingGoal', null) == null || ((data.fundingGoal is int || data.fundingGoal is float) && data.fundingGoal >= 0))
        && (data.get('priority', null) == null || data.priority in ['Critical', 'High', 'General'])
        && (data.get('status', null) == null || data.status is string)
        && (data.get('isPublic', null) == null || data.isPublic is bool);
    }

    match /patients/{patientId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 6. Stories
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 3. Donations
    function isValidDonation(data) {
      return (isAdmin() || data.get('donorId', null) == request.auth.uid || data.get('donorId', null) == null)
        && (data.get('amount', null) == null || ((data.amount is int || data.amount is float) && data.amount > 0))
        && (data.get('paymentMethod', null) == null || data.paymentMethod in ['gcash', 'card', 'crypto', 'bank_transfer'])
        && (data.get('status', null) == null || data.status in ['pending', 'verified', 'rejected'])
        && (data.get('rejectionReason', null) == null || (data.rejectionReason is string && data.rejectionReason.size() < 1000))
        && (data.get('blockchainTxHash', null) == null || (data.blockchainTxHash is string && data.blockchainTxHash.size() < 256))
        && (data.get('type', null) == null || data.type in ['direct', 'fundraiser', 'auction_payment'])
        && (data.get('currency', null) == null || data.currency in ['PHP', 'USD'])
        && (data.get('donorName', null) == null || data.donorName is string)
        && (data.get('timestamp', null) == null || data.timestamp is string)
        && (data.get('patientId', null) == null || isValidId(data.patientId))
        && (data.get('receiptUrl', null) == null || data.receiptUrl is string)
        && (data.get('auctionId', null) == null || isValidId(data.auctionId));
    }

    match /donations/{donationId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidDonation(incoming());
      allow update: if isAdmin();
    }

    // 4. Auctions
    function isValidAuctionItem(data) {
      return (data.get('title', null) == null || (data.title is string && data.title.size() < 1000))
        && (data.get('currentBid', null) == null || ((data.currentBid is int || data.currentBid is float) && data.currentBid >= 0))
        && (data.get('status', null) == null || data.status in ['draft', 'audit', 'active', 'closed', 'cancelled'])
        && (data.get('paymentStatus', null) == null || data.paymentStatus in ['pending_verification', 'verified', 'rejected'])
        && (data.get('ownerId', null) == null || isValidId(data.ownerId))
        && (data.get('lastUpdated', null) == null || data.lastUpdated is string)
        && (data.get('createdAt', null) == null || data.createdAt is string)
        && (data.get('description', null) == null || data.description is string)
        && (data.get('image', null) == null || data.image is string)
        && (data.get('imageUrl', null) == null || data.imageUrl is string)
        && (data.get('category', null) == null || data.category is string)
        && (data.get('endTime', null) == null || data.endTime is string)
        && (data.get('startPrice', null) == null || ((data.startPrice is int || data.startPrice is float) && data.startPrice >= 0))
        && (data.get('highestBidderId', null) == null || isValidId(data.highestBidderId))
        && (data.get('highestBidderName', null) == null || data.highestBidderName is string)
        && (data.get('lastBidTime', null) == null || data.lastBidTime is string)
        && (data.get('contractAddress', null) == null || data.contractAddress is string)
        && (data.get('contractDeployed', null) == null || data.contractDeployed is bool)
        && (data.get('donorContact', null) == null || (data.donorContact is string && data.donorContact.size() < 100))
        && (data.get('bidHistory', null) == null || data.bidHistory is list);
    }

    match /auctions/{auctionId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidAuctionItem(incoming());
      allow update: if isSignedIn() && (
        isAdmin() 
        || (incoming().ownerId == request.auth.uid && (existing().status == 'draft' || existing().status == 'audit'))
        || (incoming().diff(existing()).affectedKeys().hasAny(['currentBid', 'highestBidderId', 'highestBidderName', 'lastBidTime', 'lastUpdated', 'status', 'paymentStatus']))
      );
      allow delete: if isAdmin() || (isSignedIn() && existing().ownerId == request.auth.uid && (existing().status == 'draft' || existing().status == 'audit'));
    }

    match /auctions/{auctionId}/bids/{bidId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
        && incoming().bidderId == request.auth.uid 
        && incoming().amount >= get(/databases/$(database)/documents/auctions/$(auctionId)).data.currentBid;
    }

    // 5. Settings & Audit
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }

    // 7. Compiled Reports (Admin-only)
    match /reports/{reportId} {
      allow read, write: if isAdmin();
    }
  }
}
